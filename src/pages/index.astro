---
// SOURCE: zurp-astronomics-site — home of the main site (v2, at `/`): the "Low-Tech & DIY" poster pinned to the soot wall, series 2 catalog
// AUTHOR: engineer
// DATE: 2026-10-03
// STATUS: active
// REVISED: 2026-10-06 (ticket #49) — every text comes from content/ (site.yml, home/pitch.md, home/manifesto.md, catalog.yml)
// REVISED: 2026-10-21 (ticket #117) — the « => GitHub » stamp stands straight (and stays so under
//   prefers-reduced-motion); the poster no longer moves under the pointer. The poster, its tape and
//   the label keep their tilt: the one crooked gesture of the site, on purpose
//
// The layout of the home page zUrp Embedded had before the engine (src/pages/index.astro of
// 8c2fc77): a centred hero — the logo (the h1), the subtitle in orange monospaced capitals, the pitch
// — over a faint orange glow and grid, then the catalog, then the footer. The texts live in content/
// (src/lib/content.mjs): this page only places them. The catalog comes from src/data/catalog.ts (the
// product repositories). No manifesto: the engine's was astro copy, the old site's is about LCARS.
//
// Catalog: one titled shelf per section (Libraries, Tools, Future), sections and their order read
// from content/catalog.yml (`sections`, each product's `section`), never listed here. Inside a shelf,
// products keep the catalog's order (ticket #46: latest GitHub release first, then the products
// without a release by name — src/lib/catalog/assemble.mjs). A section with no product is not drawn.
// Each shelf lays its cards on the old site's auto-fill grid.
//
// The hero's title block (logo, subtitle) is the big header of src/components/v2/SiteHeader.astro
// (part="full"): it scrolls away with the page and fades out as the compact bar (drawn by V2Layout,
// `home`) fades in (ticket #31).
//
// The social card is the Low-Tech & DIY poster (src/assets/header/low-tech-diy-poster.webp), as a JPEG.
import { getImage } from 'astro:assets';
import V2Layout from '../layouts/V2Layout.astro';
import SiteHeader from '../components/v2/SiteHeader.astro';
import PosterTile from '../components/v2/PosterTile.astro';
import { getCatalog } from '../data/catalog';
import { catalogContent, inlineMarkdown, readMarkdown, siteContent } from '../lib/content.mjs';
import lowTechPoster from '../assets/header/low-tech-diy-poster.webp';

const site = siteContent();
const { sections } = catalogContent();
const pitch = inlineMarkdown(readMarkdown('home/pitch.md'));

// Social card: the poster, as a JPEG (widest support among link unfurlers), 1200 × 800.
const ogPoster = await getImage({ src: lowTechPoster, width: 1200, format: 'jpg', quality: 78 });

const catalog = await getCatalog();
const shelves = sections
  .map((section) => ({
    ...section,
    tiles: catalog
      .filter((p) => p.section === section.id)
      .map((p) => ({
        name: p.name,
        tagline: p.tagline,
        href: `/${p.slug}/`,
        poster: p.poster,
        posterAlt: p.posterAlt,
      })),
  }))
  .filter((shelf) => shelf.tiles.length > 0);
---

<V2Layout title={site.name} ogImage={ogPoster.src} home>
  <!-- A <div>, not a <header>: the big header inside it is the page's one banner. -->
  <div class="hero">
    <!-- The title (logo h1, subtitle): the site's big header. -->
    <SiteHeader part="full" />
    <div class="z2-container">
      <p class="pitch" set:html={pitch} />
    </div>
  </div>

  <main class="z2-container">
    <section class="catalog" aria-labelledby="catalog-title">
      <h2 id="catalog-title" class="z2-band">{site.home.catalogTitle}</h2>
      <div class="shelves">
        {
          shelves.map((shelf) => (
            <section class="shelf" aria-labelledby={`shelf-${shelf.id}`}>
              <h3 id={`shelf-${shelf.id}`} class="shelf-title">
                {shelf.title}
              </h3>
              <div class="grid">
                {shelf.tiles.map((t) => (
                  <PosterTile {...t} />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>
  </main>
</V2Layout>

<style>
  /* The old site's hero: an orange glow and a faint grid behind the centred title block. */
  .hero {
    position: relative;
    padding: 6rem 0 5rem;
    text-align: center;
    background:
      radial-gradient(ellipse at 20% 30%, rgba(249, 115, 22, 0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 70%, rgba(249, 115, 22, 0.04) 0%, transparent 50%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(249, 115, 22, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(249, 115, 22, 0.03) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  .hero > :global(*) {
    position: relative;
    z-index: 1;
  }

  .pitch {
    max-width: 620px;
    margin: 0 auto;
    font-size: 1.1rem;
    color: var(--fg-muted);
  }

  section.catalog {
    padding: 4rem 0;
  }

  .shelves {
    display: flex;
    flex-direction: column;
    row-gap: 3rem;
  }

  /* A shelf's title: the old card's category line, a little larger. */
  .shelf-title {
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 4rem 0 3rem;
    }
    section.catalog {
      padding: 3rem 0;
    }
  }
</style>
