---
// SOURCE: zurp-astronomics-site — the main site's (v2) common header: photographed zUrp plate, subtitle, hairline; full size on the home page (scrolls away), compact fixed bar faded in by the scroll
// AUTHOR: engineer
// DATE: 2026-10-03
// STATUS: active
// REVISED: 2026-10-06 (ticket #49) — the subtitle, the plate's alt and the link's label come from content/site.yml (`header`)
//
// Tickets #27, #29, #31. The header is the zUrp Embedded logo (src/assets/header/logo_zUrp-embedded.png,
// a black drawing on white, shown inverted on the dark page as the site of 8c2fc77 did; a link to
// `/`) and the subtitle under it. It exists in two parts, both drawn by this component, so the two
// sets of proportions live in one place:
//
//   - part="full" — the big header, HOME PAGE ONLY, drawn by src/pages/index.astro as the first
//     thing inside its `.hero` (the old site's hero). Logo 520 px max, 80 % of the width (the old
//     site's `.hero-logo`). The logo is the page's h1. It is in
//     the flow and simply scrolls up with the page: no fixed position, no reserved height, no
//     resizing. It fades out (opacity 1 → 0) as the compact bar fades in, see below.
//   - part="bar" (default) — the compact bar, drawn by V2Layout.astro on EVERY page. Logo 168 px
//     (120 px on phones), small subtitle, on the raised background with a bottom border. Its logo is
//     a link to `/` (on the home page, the way back to the top) and NEVER a heading.
//       · product pages: sticky at the top from the start, in the flow (nothing hidden under it on
//         load), always visible, no script involved; the page's h1 is the product name;
//       · home page (`home`): fixed at the top of the screen and invisible at first. Between
//         FADE_START and FADE_END px of scroll (constants at the top of the script below) a
//         progress p goes from 0 to 1, proportional to the scroll position — no timer, no CSS
//         transition: stop scrolling and the fade stops, scroll back and it runs backwards. The
//         bar fades in (opacity p, with a short slide down from above) while the big header fades
//         out (opacity 1 − p). The script writes p as `--head-p` on the two parts.
//         While p < 0.5 the bar is `inert` (neither clickable nor reachable by keyboard or screen
//         reader) and, at p = 0, `visibility: hidden`. Under prefers-reduced-motion there is no
//         gradual fade: p jumps 0 → 1 at the middle of the range, and back.
//         Without JavaScript the bar stays hidden and inert (markup default) and the big header
//         just scrolls away: accepted (ticket #31).
//         `inert={home}`, a boolean: Astro 7 renders `inert` as a boolean attribute, so the former
//         `inert={home ? '' : undefined}` (an empty string, falsy) dropped it from the markup
//         (measured in ticket #43, Astro 4 → 7).
//
// Ticket #31 removed the #27 / #29 machinery (outer box locking the full height, sentinel,
// hysteresis thresholds, 0.8 s transition on the plate's size): the header no longer changes size.
//
// h1 semantics (deliberate): one h1 per page. Home: the big header's plate. Product pages: the
// product name (visually hidden, in src/pages/[slug]/index.astro); the bar's plate is a plain link.
// Landmarks: one banner per page — the big header (<header>) on the home page, where the bar is a
// <div>; the bar (<header>) on product pages.
import { Image } from 'astro:assets';
import plate from '../../assets/header/logo_zUrp-embedded.png';
import { siteContent } from '../../lib/content.mjs';

interface Props {
  /** 'bar' (default): the compact bar, drawn by V2Layout. 'full': the home page's big header. */
  part?: 'bar' | 'full';
  /** With part 'bar': the home page — the bar is fixed, hidden at the top and faded in by scroll. */
  home?: boolean;
}

const { part = 'bar', home = false } = Astro.props;
const { header } = siteContent();
const full = part === 'full';
// The bar's element. Home: a <div> (the big header is the page's banner), inert and hidden until
// the script shows it. Product pages: the page's <header>, always visible.
const Bar = home ? 'div' : 'header';
---

{
  full ? (
    <header class="site-head site-head-full">
      <div class="z2-container site-head-inner">
        <!-- The logo, inverted by CSS (the source is black on white). 1x/2x variants up to 1040 px. -->
        <h1 class="site-head-title">
          <a class="site-head-home" href="/" aria-label={header.homeLabel} aria-current="page">
            <Image
              src={plate}
              alt={header.plateAlt}
              width={1040}
              widths={[300, 520, 780, 1040]}
              sizes="(max-width: 640px) 90vw, 520px"
              format="webp"
              quality={80}
              loading="eager"
              class="site-head-plate"
            />
          </a>
        </h1>
        <!-- The subtitle: part of the title block, not of the h1 (the logo stays alone in it). -->
        <p class="site-head-subtitle">{header.subtitle}</p>
      </div>
    </header>
  ) : (
    <Bar class="site-head site-bar" data-fade={home ? '' : undefined} inert={home}>
      <div class="z2-container site-head-inner">
        <div class="site-head-title">
          <a
            class="site-head-home"
            href="/"
            aria-label={header.homeLabel}
            aria-current={home ? 'page' : undefined}
          >
            <Image
              src={plate}
              alt={header.plateAlt}
              width={880}
              widths={[300, 440, 600, 880]}
              sizes="(max-width: 640px) 120px, 168px"
              format="webp"
              quality={80}
              loading="eager"
              class="site-head-plate"
            />
          </a>
        </div>
        <p class="site-head-subtitle">{header.subtitle}</p>
      </div>
    </Bar>
  )
}

<script>
  // Home page only: fade the compact bar in, and the big header out, in proportion to the scroll.
  //
  // FADE_START / FADE_END: the scroll range (px from the top of the page) over which the fade runs.
  // Up to FADE_START: big header only (p = 0). From FADE_END on: compact bar only (p = 1), fixed at
  // the top. In between, p is linear in the scroll position; at mid-range both are half visible.
  // Tune these two numbers freely (FADE_END > FADE_START); nothing else depends on them.
  const FADE_START = 100; // px
  const FADE_END = 200; // px
  // From this progress on the bar can be clicked and tabbed to; below it, it is inert.
  const LIVE_FROM = 0.5;

  const bar = document.querySelector<HTMLElement>('.site-bar[data-fade]');
  if (bar) {
    const full = document.querySelector<HTMLElement>('.site-head-full');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let shown = -1;

    const progress = (y: number) => {
      // Reduced motion: all or nothing, switched at the middle of the range.
      if (reduce.matches) return y >= (FADE_START + FADE_END) / 2 ? 1 : 0;
      return Math.min(1, Math.max(0, (y - FADE_START) / (FADE_END - FADE_START)));
    };

    const update = () => {
      const p = Math.round(progress(window.scrollY) * 1000) / 1000;
      if (p === shown) return;
      shown = p;
      bar.style.setProperty('--head-p', String(p));
      full?.style.setProperty('--head-p', String(p));
      bar.classList.toggle('is-on', p > 0);
      // The attribute, not the property: browsers without `inert` still get pointer-events: none.
      bar.toggleAttribute('inert', p < LIVE_FROM);
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    reduce.addEventListener?.('change', update);
    update();
  }
</script>

<style is:global>
  /*
   * Global on purpose: the script toggles `.is-on` and writes `--head-p` at run time.
   * The look is the old site's hero (src/pages/index.astro of 8c2fc77): the logo inverted, the
   * subtitle in orange monospaced capitals.
   */

  /* Anchor jumps and focus scrolling land below the compact bar, never under it. */
  html {
    scroll-padding-top: 6rem;
  }

  /* --- Shared by both parts ----------------------------------------------------------------- */

  .site-head-inner {
    text-align: center;
  }

  .site-head-title {
    margin: 0;
    line-height: 0;
  }

  /* The link carries the logo's size, so the image only fills it. */
  .site-head-home {
    display: block;
    margin: 0 auto;
  }

  /* The source is black on white: inverted, it is white on the dark page (the old site's filter). */
  .site-head-plate {
    display: block;
    width: 100%;
    height: auto;
    filter: invert(1) brightness(1.1);
  }

  /* The old site's `.tagline`. */
  .site-head-subtitle {
    font-family: var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* --- The big header (home page, in the flow) ------------------------------------------------ */

  /* Fades out while the compact bar fades in (`--head-p`, set by the script; 0 without it). */
  .site-head-full {
    opacity: calc(1 - var(--head-p, 0));
  }

  .site-head-full .site-head-home {
    width: min(80%, 520px);
    margin-bottom: 2rem;
  }

  .site-head-full .site-head-subtitle {
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  /* --- The compact bar ------------------------------------------------------------------------ */

  /* Product pages: sticky, in the flow. */
  .site-bar {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 0.7rem 0;
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
  }

  /* Home page: fixed over the page, out of the flow, invisible until the scroll reaches FADE_START;
     then opacity = p, with a short slide down from above. Hidden outright at p = 0 (and without
     JavaScript); clicks pass through while it is inert. No transition: it follows the scroll. */
  .site-bar[data-fade] {
    position: fixed;
    left: 0;
    right: 0;
    opacity: var(--head-p, 0);
    transform: translateY(calc((var(--head-p, 0) - 1) * 0.75rem));
    visibility: hidden;
  }

  .site-bar[data-fade].is-on {
    visibility: visible;
  }

  .site-bar[inert] {
    pointer-events: none;
  }

  .site-bar .site-head-home {
    width: 168px;
  }

  .site-bar .site-head-subtitle {
    margin-top: 0.4rem;
    font-size: 0.62rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* --- Phones --------------------------------------------------------------------------------- */

  @media (max-width: 640px) {
    html {
      scroll-padding-top: 5rem;
    }
    .site-head-full .site-head-home {
      width: min(90%, 300px);
    }
    .site-bar .site-head-home {
      width: 120px;
    }
    .site-bar .site-head-subtitle {
      margin-top: 0.25rem;
      font-size: 0.56rem;
      letter-spacing: 0.12em;
    }
  }
</style>
