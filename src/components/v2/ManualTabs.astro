---
// SOURCE: zurp-astronomics-site — the manual of a product page in tabs (Overview, Assembly, Setup, Usage), the Install block in the Setup tab; nothing but its slot without a manual
// AUTHOR: engineer
// DATE: 2026-10-20
// STATUS: active — ticket #111
// REVISED: 2026-10-21 (ticket #117) — the tabs and the manual's titles stand straight, a tab no longer
//   moves under the pointer (the selected one stays raised: a state); the tab list in the row
//   `.z2-tabrow` (src/layouts/V2Layout.astro), the page's GitHub link (the `link` slot) at its right
//   end — a link beside the tab list, never in it: out of the arrow keys, in the Tab order
//
// Used by src/pages/[slug]/index.astro around its #install block (the default slot):
//   - WITHOUT a manual (`tabs` null), it renders its default slot and nothing else: the #install
//     block in its place (the slot's markup is the page's, with the page's scoped styles); the page
//     draws the row of its GitHub link itself, under the pitch;
//   - WITH a manual, the tabs of src/lib/manual.mjs (manualTabs): a row holding the tab list and the
//     `link` slot (the page's GitHub link), then one panel per tab, the first one shown; the default
//     slot (the #install block) in the Setup panel, after the project's text.
// The WAI-ARIA tabs pattern: role tablist / tab / tabpanel, aria-selected, aria-controls,
// aria-labelledby, one tab in the Tab order (tabindex 0, the others -1). The behaviour — the click,
// the arrow, Home and End keys, the anchors (`#overview`…, `#install` opening Setup) — is in the
// script of the page, which every product page already loads: a script here would add a tag to the
// pages without a manual.
//
// The panels' text is the manual's Markdown, rendered by src/lib/catalog/manual.mjs (raw HTML
// escaped, images and links rewritten), set as HTML: its elements carry no scope attribute, hence
// the :global() of the styles below. `lang` is the language of the file shown (`fr` when the `.en.md`
// is missing). The titles are the site's (content/site.yml, `product.manual`).
import { fill } from '../../lib/content.mjs';

interface Props {
  tabs: Array<{ id: string; lang: string | null; html: string | null; install: boolean }> | null;
  texts: { label: string; tabs: Record<string, string> } | null;
  product: string;
}

const { tabs, texts, product } = Astro.props;
---

{
  tabs && texts ? (
    <div class="manual" data-manual>
      <div class="z2-tabrow">
        <div class="manual-tabs" role="tablist" aria-label={fill(texts.label, { product })}>
          {tabs.map((t, i) => (
            <button
              type="button"
              class="manual-tab"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={t.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? '0' : '-1'}
              data-tab={t.id}
            >
              {texts.tabs[t.id]}
            </button>
          ))}
        </div>
        <slot name="link" />
      </div>
      {tabs.map((t, i) => (
        <div class="manual-panel" role="tabpanel" id={t.id} aria-labelledby={`tab-${t.id}`} tabindex="0" hidden={i !== 0} data-tab-panel={t.id}>
          {t.html !== null && <div class="manual-text" lang={t.lang ?? undefined} data-manual-text set:html={t.html} />}
          {t.install && <slot />}
        </div>
      ))}
    </div>
  ) : (
    <slot />
  )
}

<style>
  /* The minimal look of the old site, which had no tabs: a row of quiet buttons over a thin rule
     (the row's, .z2-tabrow), the open one in the product's accent. */
  .manual {
    padding: 2rem 0 1rem;
    border-top: 1px solid var(--border);
    /* Under the sticky header of product pages when an anchor scrolls to it. */
    scroll-margin-top: 6rem;
  }

  .manual-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .manual-tab {
    cursor: pointer;
    padding: 0.55rem 1rem;
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    background: var(--bg);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
  }

  .manual-tab[aria-selected='true'] {
    background: var(--product-accent, var(--accent));
    border-color: var(--product-accent, var(--accent));
    color: var(--product-on-accent, var(--bg));
    font-weight: 600;
  }

  .manual-tab:focus-visible,
  .manual-panel:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .manual-panel {
    padding-top: 1.75rem;
  }

  /* The install block after the project's text, apart from it. */
  .manual-text + :global(section) {
    margin-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .manual-panel > :global(section:first-child) {
    padding-top: 0.5rem;
  }

  .manual-text {
    max-width: 680px;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--fg-muted);
  }

  .manual-text :global(:where(p, ul, ol, pre, blockquote, table, hr)) {
    margin: 0 0 1.2rem;
  }

  .manual-text :global(:where(ul, ol)) {
    padding-left: 1.6rem;
  }

  .manual-text :global(li + li) {
    margin-top: 0.35rem;
  }

  /* The sections of a manual start at ## (§ 7 of the guide): the page's own section titles. */
  .manual-text :global(h2) {
    margin: 2rem 0 1rem;
    font-size: 1.6rem;
    color: var(--fg);
  }

  .manual-text > :global(h2:first-child) {
    margin-top: 0;
  }

  .manual-text :global(:where(h1, h3, h4, h5, h6)) {
    margin: 1.6rem 0 0.8rem;
    font-size: 1.2rem;
    color: var(--fg);
  }

  .manual-text :global(h1) {
    font-size: 1.8rem;
  }

  .manual-text :global(img) {
    display: block;
    margin: 1.2rem 0;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .manual-text :global(code) {
    padding: 0.1em 0.4em;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    font-size: 0.95em;
    color: var(--fg);
  }

  .manual-text :global(pre) {
    overflow-x: auto;
    padding: 1rem 1.2rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    line-height: 1.5;
    color: var(--fg);
  }

  .manual-text :global(pre code) {
    padding: 0;
    background: none;
    border: 0;
  }

  .manual-text :global(blockquote) {
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 3px solid var(--accent);
  }

  .manual-text :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .manual-text :global(:where(th, td)) {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    text-align: left;
  }

  .manual-text :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .manual-tab {
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
    }
  }
</style>
