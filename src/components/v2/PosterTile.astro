---
// SOURCE: zurp-astronomics-site — main site (v2) catalog tile: a series 2 poster hung on the soot wall, with a label strip
// AUTHOR: engineer
// DATE: 2026-10-03
// STATUS: active
// REVISED: 2026-10-21 (ticket #117) — a tile no longer moves under the pointer: the accent ring
//   around its poster (hover, focus) and the dashed focus outline say it
//
// The look is the old site's product card (src/components/ProductCard.astro of 8c2fc77): a raised
// panel with a thin border that turns orange under the pointer (it does not lift: ticket #117), the
// poster on top, then the name and the tagline.
// `data-catalog-tile` on the <Image> is what scripts/check-dist.mjs keys its 600 px tile rule on.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  tagline: string;
  href: string;
  poster: ImageMetadata;
  posterAlt: string;
}

const { name, tagline, href, poster, posterAlt } = Astro.props;
---

<a class="tile" href={href}>
  <!-- Whole poster, never cropped. Weight budget: no variant wider than 600 px, `width` pins the fallback src at 600 too. -->
  <Image
    src={poster}
    alt={posterAlt}
    width={600}
    widths={[320, 480, 600]}
    sizes="(max-width: 640px) min(calc(100vw - 2rem), 600px), (max-width: 1100px) 45vw, 350px"
    format="webp"
    quality={78}
    class="poster"
    data-catalog-tile
  />
  <span class="label">
    <strong class="name">{name}</strong>
    <span class="tagline">{tagline}</span>
  </span>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    color: var(--fg);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color 0.2s ease;
  }

  .tile:hover,
  .tile:focus-visible {
    border-color: var(--accent);
    opacity: 1;
  }

  .poster {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: 4px;
  }

  .label {
    display: block;
    flex: 1;
    margin-top: 1rem;
  }

  .name {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--fg);
  }

  .tagline {
    display: block;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
</style>
